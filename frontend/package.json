{
  "name": "ddas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop_app/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"node ../desktop_app/electron/wait-and-launch.cjs\"",
    "electron:build": "npm run build && electron-builder"
  },
  "description": "Data Download Duplication Alert System",
  "author": "Indra-2005",
  "dependencies": {
    "axios": "^1.11.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "form-data": "^4.0.5",
    "lucide-react": "^0.561.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "vite": "^7.1.2",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ddas.alertsystem",
    "productName": "DDAS",
    "icon": "../desktop_app/icon.png",
    "asar": true,
    "files": [
      "dist/**/*",
      {
        "from": "../desktop_app/electron",
        "to": "desktop_app/electron",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../desktop_app",
        "to": "desktop_app",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      },
      "package.json"
    ],
    "win": {
      "icon": "../desktop_app/icon.ico",
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "../desktop_app/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../desktop_app/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "dist-electron"
    }
  }
}
