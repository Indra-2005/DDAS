# =============================================================================
# DDAS Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.
# =============================================================================

# --- Database ---
MONGO_URI=mongodb://localhost:27017/ddas
DB_NAME=ddas

# --- File Storage ---
STORAGE_PATH=./storage

# --- Authentication (JWT) ---
# REQUIRED: Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin Registration ---
# REQUIRED for creating tenant admin accounts. Set a strong unique value.
ADMIN_SECRET=CHANGE_ME_TO_A_STRONG_ADMIN_SECRET

# --- Encryption (AES-256-GCM) ---
# REQUIRED: 64 hex characters (32 bytes). MUST be different from JWT_SECRET.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS_HERE_GENERATE_WITH_PYTHON

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=500

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
